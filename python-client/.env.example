# ----------------------------------------------------------------
# Go API wrapper
# ----------------------------------------------------------------
# URL where the Go wrapper is reachable (default: http://localhost:8181)
GO_API_URL=http://localhost:8181

# ----------------------------------------------------------------
# Bitso credentials – one pair per user
# Pattern: <USER_UPPER>_API_KEY and <USER_UPPER>_API_SECRET
# ----------------------------------------------------------------
# Example for a user identified as "alice":
ALICE_API_KEY=your_bitso_api_key_here
ALICE_API_SECRET=your_bitso_api_secret_here

# Comma-separated list of user identifiers to sync
BITSO_USERS=alice

# Comma-separated list of trading books to query
BITSO_BOOKS=btc_mxn,eth_mxn

# ----------------------------------------------------------------
# MongoDB
# ----------------------------------------------------------------
MONGODB_URI=mongodb://user:password@localhost:27017
MONGODB_DB=bitso

# ----------------------------------------------------------------
# Scheduler
# ----------------------------------------------------------------
# How often (in minutes) to run the data sync (default: 5)
SCHEDULER_INTERVAL_MINUTES=5
