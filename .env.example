# Copia este archivo a .env y llena los valores. .env no se sube a git.

# --- Bitso (API key de SOLO LECTURA para el servicio de sync) ---
BITSO_API_KEY=
BITSO_API_SECRET=
# 1 = imprime los bodies de request/response en el log (nunca los headers)
BITSO_DEBUG=0

# Valor del campo "user" en las colecciones de Mongo
BITSO_USER=icf

# --- MongoDB ---
# Se permite ${VAR} dentro del URI (lo expanden compose y el propio sync)
MONGODB_USRB=
MONGODB_PASSB=
MONGODB_URI=mongodb://${MONGODB_USRB}:${MONGODB_PASSB}@host1:27017,host2:27017/?authSource=admin&replicaSet=seiiki
MONGO_DB=defi

# --- Sync ---
# Hora local (TZ) a la que corre la sincronización diaria, formato HH:MM.
# El snapshot de saldos solo se guarda el día 15 y el último día del mes.
SYNC_TIME=23:50
TZ=America/Mexico_City
